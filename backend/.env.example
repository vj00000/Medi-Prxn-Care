# --- Database configuration ---
# Default: local SQLite file (no server required, ideal for quick local runs).
DATABASE_URL=sqlite:///./smart_rx.db

# PostgreSQL (this is what docker-compose injects for the api service).
# Host port 5433 is used to avoid clashing with an existing 5432 container.
# DATABASE_URL=postgresql+psycopg2://smartrx:smartrx@localhost:5433/smartrx

# --- Google Gemini (AI pipeline) ---
# Required for POST /ai/extract. Without it the endpoint returns HTTP 503.
# Get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AQ.Ab8RN6I_U17GObi4qxsSR0cTmpjXPwTnWH2lseCgI1GaloOFMw

# Optional: override the model (default: gemini-3.8-flash).
# Model availability varies per key — if you get a 404 "model is not found",
# run: docker compose exec api python -c "import google.generativeai as g, os;
#   g.configure(api_key=os.getenv('GEMINI_API_KEY')); print([m.name for m in g.list_models()])"
# GEMINI_MODEL=gemini-3.8-flash
